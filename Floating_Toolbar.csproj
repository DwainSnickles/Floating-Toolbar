<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FloatingToolbar</RootNamespace>
    <AssemblyName>FloatingToolbar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Floating Toolbar</Product>
    <AssemblyTitle>Floating Toolbar</AssemblyTitle>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded too, so the tray and window icons can use the same artwork as the .exe. -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="FloatingToolbar.app.ico" />
  </ItemGroup>

</Project>
